# Copy to .env and fill in. .env is git-ignored.
# Local development: values printed by `npx supabase status`.
# Only the public project URL and the anon/publishable key belong here.
# NEVER put the service_role / secret key in this file.
# Release builds (npm run dist, npm run android:build) read .env.production
# first, with the cloud project URL and publishable key; see docs/release.md.
DIDIFLOW_SUPABASE_URL=http://127.0.0.1:54321
DIDIFLOW_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# Optional: default Gmail account for notification e-mails. Packaged desktop
# builds embed it encrypted (AES-256-GCM, per-build key) in the main process;
# development and test runs never use it. Use a Gmail app password (16
# letters), never the account password. See docs/security.md before using.
DIDIFLOW_GMAIL_ADDRESS=
DIDIFLOW_GMAIL_APP_PASSWORD=
