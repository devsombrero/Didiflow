# Copy to .env and fill in. .env is git-ignored.
# Local development: values printed by `npx supabase status`.
# Only the public project URL and the anon/publishable key belong here.
# NEVER put the service_role / secret key in this file.
DIDIFLOW_SUPABASE_URL=http://127.0.0.1:54321
DIDIFLOW_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key
