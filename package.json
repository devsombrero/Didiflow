{
  "name": "didiflow",
  "version": "0.6.1",
  "scripts": {
    "ng": "ng",
    "start": "npm run env && ng serve",
    "build": "npm run env && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "ng test --watch=false",
    "electron:build": "node electron/build.mjs",
    "electron:dev": "concurrently -k -n ng,electron \"npm run env && ng serve\" \"wait-on http://localhost:4200 && npm run electron:build && cross-env DIDIFLOW_DEV_SERVER_URL=http://localhost:4200 electron .\"",
    "electron:start": "npm run build && npm run electron:build && electron .",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "test:electron": "vitest run --config electron/vitest.config.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "env": "node scripts/write-env.mjs",
    "db:types": "supabase gen types typescript --local --schema public > src/app/core/supabase/database.types.ts",
    "test:integration": "node --test \"tests/integration/**/*.test.mjs\"",
    "test:e2e": "npm run build && npm run electron:build && playwright test",
    "icon": "node scripts/generate-icon.mjs",
    "dist": "npm run build && npm run electron:build && electron-builder --win --publish never",
    "android:build": "node scripts/build-android.mjs",
    "android:emulator": "node scripts/android-emulator.mjs",
    "manual": "electron scripts/build-manual.cjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@swimlane/ngx-charts": "^25.0.3",
    "marked": "^18.1.1",
    "material-symbols": "^0.47.6",
    "ngx-markdown": "^22.1.1",
    "nodemailer": "^10.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/nodemailer": "^8.0.2",
    "angular-eslint": "22.6.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.122.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.5"
  },
  "main": "dist-electron/main.cjs",
  "description": "DidiFlow — gestão pessoal de demandas, prazos e indicadores.",
  "author": {
    "name": "Deyvid Santos",
    "email": "deyvidsantosdatascience@gmail.com"
  }
}
